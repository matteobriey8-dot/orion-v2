# ── Serveur ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Gemini ──────────────────────────────────────────────────────────
# Obtenir sur : https://aistudio.google.com/apikey
GEMINI_API_KEY=ta_cle_gemini_ici
GEMINI_MODEL=gemini-2.0-flash

# ── MongoDB ─────────────────────────────────────────────────────────
# Gratuit sur : https://cloud.mongodb.com
# Format : mongodb+srv://user:password@cluster.mongodb.net/orion
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/orion

# ── JWT ─────────────────────────────────────────────────────────────
# Chaîne aléatoire longue — ne jamais partager
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire_secrete
